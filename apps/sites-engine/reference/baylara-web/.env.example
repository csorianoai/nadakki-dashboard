# Copia como .env.local para desarrollo. En Vercel se configuran en Project Settings → Environment Variables.
# Email de formularios (Resend). Sin estas variables el formulario responde 503 y no envía.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Baylara <leads@baylara.com>"
LEAD_TO_EMAIL=cesar@nadakki.com

# Medición (opcionales: si faltan, el sitio funciona igual sin etiqueta de Google)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=

# URL canónica (para hreflang, sitemap). No conectar el dominio sin aprobación de César.
NEXT_PUBLIC_SITE_URL=https://baylara.com
