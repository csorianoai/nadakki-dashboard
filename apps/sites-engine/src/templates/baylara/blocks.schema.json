{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nadakki.invalid/sites/templates/baylara/blocks.schema.json",
  "title": "baylara.profile",
  "description": "INTERFAZ de importacion de Baylara al core: bloque `baylara.profile` de la pagina `home`. Lleva los campos de site.json que el manifiesto aun no trae (se retira cuando S1 amplie el manifiesto).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "type": "object", "additionalProperties": false,
      "properties": { "name": { "type": "string", "maxLength": 120 }, "title": { "$ref": "#/$defs/i18n" }, "photo": { "type": "string", "maxLength": 80, "description": "id de PublicMedia" } }
    },
    "brokerage_address": { "type": "string", "maxLength": 300 },
    "mls_disclaimer": { "$ref": "#/$defs/i18n" },
    "dr_partner_brokerage": { "type": "string", "maxLength": 200 },
    "response_time": { "$ref": "#/$defs/i18n" },
    "valuation_days": { "type": "integer", "minimum": 1, "maximum": 60 },
    "testimonials": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["quote", "author"],
        "properties": { "quote": { "$ref": "#/$defs/i18n" }, "author": { "type": "string", "maxLength": 120 }, "role": { "type": "string", "maxLength": 120 } }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object", "additionalProperties": false, "required": ["es"],
      "properties": { "es": { "type": "string", "maxLength": 2000 }, "en": { "type": "string", "maxLength": 2000 } }
    }
  }
}
