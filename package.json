{
  "name": "nadakki-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:webpack": "next build --webpack",
    "build:turbopack": "next build --turbopack",
    "start": "next start",
    "lint": "eslint app/page.tsx components/layout/AgentCountDisplay.tsx components/layout/SidebarSuiteStats.tsx app/hooks/useAgentRegistrySummary.ts lib/api/agent-registry.ts lib/api/endpoints.ts lib/agent-registry/parse-summary.ts components/agent-registry/AgentRegistryStatHome.tsx types/agent-registry.ts \"app/(bank)/bank/applications/**/*.tsx\" lib/bank-application-detail/**/*.ts lib/bank-decision/**/*.ts components/bank-application-detail/**/*.tsx components/ui/dialog.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:run": "jest",
    "test:e2e": "playwright test",
    "test:e2e:autos": "playwright test e2e/autos-portal",
    "smoke:autos:gates": "node tools/smoke/verify-autos-20-gates.mjs",
    "test:e2e:cockpit": "playwright test -c playwright.config.cockpit.ts",
    "dev:stable": "next dev --webpack -p 3001",
    "frontend:check": "powershell -ExecutionPolicy Bypass -File ./tools/frontend_full_check.ps1",
    "frontend:nav-check": "node ./tools/frontend_nav_check.mjs",
    "docs:tokens": "node ./tools/docs/build-tokens-md.mjs",
    "docs:components": "node ./tools/docs/capture-components.mjs",
    "docs:pages": "node ./tools/docs/capture-pages.mjs",
    "docs:validate": "node ./tools/docs/validate-docs.mjs --strict",
    "docs:all": "npm run docs:tokens && npm run docs:components && npm run docs:pages && npm run docs:validate"
  },
  "dependencies": {
