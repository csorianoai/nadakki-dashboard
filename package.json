    "@types/jest": "^30.0.0",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.0.2",
    "minimatch": "^10.1.2",
    "playwright": "^1.59.1",
