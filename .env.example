# Server-side backend base for Next rewrites
BACKEND_URL=http://127.0.0.1:8000

# Default tenant for API calls when none selected (pilot)
NEXT_PUBLIC_DEFAULT_TENANT_ID=0a91ee98-2dbe-46d0-a43c-3fc2dbd42242

# --- Sentry / client telemetry (EP-T3-2) ---
NEXT_PUBLIC_SENTRY_DSN=
# Optional 0–1 override for browser tracing (defaults: 0.1 prod / 1.0 dev)
NEXT_PUBLIC_SENTRY_SAMPLE_RATE=0.1
# Set to "false" to disable Sentry, Web Vitals batching, and delegated click tracking
NEXT_PUBLIC_ENABLE_TELEMETRY=true

# Set to "true" to activate /competitor-research route and sidebar link
NEXT_PUBLIC_COMPETITIVE_RESEARCH_ENABLED=false

# === Consent Remote Flow ===
# URL pública del dashboard para construir links de consent (debe matchear backend)
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.nadakki.com

# Public API base — single source for `NEXT_PUBLIC_API_URL`
NEXT_PUBLIC_API_URL=https://nadakki-ai-suite.onrender.com

# Agent-4 bank stipulations orchestrator (META T6.3): fail-closed unless "true"/"1"
NEXT_PUBLIC_BANK_STIPULATION_WORKFLOW_UI=false

# Agent-4 META MVP 2 — T6.1 document preview in bank workflow (PDF viewer). Omit or set false/0/off to disable UI.
NEXT_PUBLIC_FEATURE_DOCUMENT_PREVIEW_UI=true

# Agent-3 T6.7 — compressed dealer wizard (META MVP 4). Set false to use legacy DealerNewWizard.
NEXT_PUBLIC_FEATURE_COMPRESSED_WIZARD=true

# Agent-3 T6.4 — application health gauge on dealer application detail (default on).
NEXT_PUBLIC_FEATURE_APP_HEALTH_SCORE=true

# Agent-3 T6.5 — risk-based dealer playbook ribbon (META MVP 4; default ON).
NEXT_PUBLIC_FEATURE_RISK_BASED_UX=true