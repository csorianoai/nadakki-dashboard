# E2E Test Environment Variables

# DO NOT commit actual credentials - this is only a template
# Copy to .env.e2e.local and fill with real values

# Platform superadmin token (30min validity)
# Get from: https://nadakki-ai-suite-staging.onrender.com/admin/tokens
# CRITICAL: Do NOT write this in git commits - it triggers secret scanning
QA_SUPERADMIN_TOKEN=

# These are generated dynamically per test run, but can be overridden for debugging
# QA_BANK_EMAIL=analista-{timestamp}@qa.local
# QA_BANK_PASSWORD=QABank2026!Seguro
# QA_DEALER_EMAIL=dealer-{timestamp}@qa.local
# QA_DEALER_PASSWORD=QADealer2026!Seguro

# Staging environment
STAGING_BACKEND=https://nadakki-ai-suite-staging.onrender.com
LOCAL_FRONTEND=http://localhost:3000
