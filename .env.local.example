# API Backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Tenant default (para desarrollo)
NEXT_PUBLIC_DEFAULT_TENANT=nadakki

# App environment
NEXT_PUBLIC_APP_ENV=local

# Feature flags
NEXT_PUBLIC_FEATURE_VOICE_SEARCH=true
NEXT_PUBLIC_FEATURE_TRADE_IN=true
NEXT_PUBLIC_FEATURE_CONCIERGE=true

# Fase 8 AI Agent (flip to true when backend ready)
NEXT_PUBLIC_FEATURE_PERSONAL_SHOPPER_BACKEND=false
NEXT_PUBLIC_FEATURE_PUBLISH_1CLICK_BACKEND=false
NEXT_PUBLIC_FEATURE_VEHICLE_CHAT_BACKEND=false
NEXT_PUBLIC_FEATURE_LEAD_SCORING_BACKEND=false
NEXT_PUBLIC_FEATURE_INSIGHTS_BACKEND=false

# Cloudinary (fotos vehiculos, para produccion)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=du73i4u1u
